# Gemini-only build: no torch, no model, no adapter. Use with COPILOT_MODEL_ENABLED=0.
FROM python:3.11-slim
WORKDIR /app
RUN pip install --no-cache-dir "google-auth>=2.30,<3" "requests>=2.32,<3" "cachecontrol>=0.14,<0.15" "fastapi>=0.110,<1.0" "cryptography>=42.0" "google-cloud-firestore>=2.16,<3.0" "firebase-admin>=6.5,<8.0"
COPY tools ./tools
COPY platform_service ./platform_service
ENV PYTHONPATH=/app PYTHONUNBUFFERED=1
ENV COPILOT_HOST=0.0.0.0
CMD ["python", "-m", "tools.voice.dashboard_llm.server.app"]
