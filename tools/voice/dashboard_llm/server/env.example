# Copy to .env on the server and fill in.
FIREBASE_PROJECT_ID=cos40005
# Company mode: set both to serve every company in the directory. FIREBASE_PROJECT_ID is then ignored.
PLATFORM_PUBLIC_KEYS=
PLATFORM_PROJECT_ID=
# Accept threshold of the fine-tuned model. v2: 0.996, chosen on the validation split (2% wrong-call limit).
COPILOT_THRESHOLD=0.996
# Dashboard origins, comma separated. Each one is the exact origin of the dashboard: scheme and host, no path,
# no trailing slash, no wildcard. Live: https://scootsales.my
ALLOWED_ORIGINS=
# Gemini key. The droplet runs with Gemini only (COPILOT_MODEL_ENABLED=0), so the key is required there.
# Never put a real key in a file of the repository. The live key lives only in the server settings file.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Seconds one Gemini call may take (one attempt, no retry). Keep it below the dashboard limit of 10 seconds.
GEMINI_MAX_SECONDS=6
# Gemini calls running at the same time in this process. More are answered "unavailable" at once.
GEMINI_MAX_CONCURRENT=4
# Gemini calls per day, per company, for dashboard users and for salespeople.
# With COPILOT_BUDGET_PROJECT set the count is saved to the central Firestore every 2 seconds and read back after a
# restart (needs GOOGLE_APPLICATION_CREDENTIALS; run one copilot process per budget project). Without it, in memory only.
GEMINI_DAILY_LIMIT=500
GEMINI_DAILY_LIMIT_SALESMAN=200
# Gemini calls per day for one person of any role. A person who used their share is refused; colleagues are not affected.
GEMINI_DAILY_LIMIT_PERSON=25
COPILOT_BUDGET_PROJECT=
# Set to 0 to skip the fine-tuned model and answer only with Gemini (needs GEMINI_API_KEY). Default 1.
# The droplet (deploy/droplet/scoot-copilot.service) runs with 0. Set it in the server settings file, not here.
COPILOT_MODEL_ENABLED=1
# Address and port the server listens on. Default 0.0.0.0 and 8080 (Docker). The droplet uses 127.0.0.1 and 8101.
COPILOT_HOST=0.0.0.0
PORT=8080
COPILOT_BODY_TIMEOUT=5
COPILOT_REQUEST_TIMEOUT=30
COPILOT_MAX_PENDING=2
