# Root OTP API configuration (development only). Copy to a local environment
# manager; server.js reads process environment variables and never requires this
# file directly. OTP_MODE, OTP_DEV_ACKNOWLEDGED and SMTP_* below belong to
# server.js only. The platform service sends no mail through SMTP or Mailpit.
PORT=8080
NODE_ENV=development
OTP_MODE=dev-mailpit
OTP_DEV_ACKNOWLEDGED=1
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
# Comma-separated exact browser origins allowed to call OTP/FastAPI endpoints.
# Add a manually selected Flutter --web-port origin here when needed.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5000,http://localhost:8080,http://127.0.0.1:3000,http://127.0.0.1:5000,http://127.0.0.1:8080

# Forecast API remains local-only unless Firestore mirroring is explicitly
# enabled. Production should use runtime ADC, not a credential file.
FORECAST_PUSH_FIRESTORE=0
FIREBASE_SERVICE_ACCOUNT=

# Optional: Google AI Studio key, only for tools/voice/dashboard_llm/evaluate_gemini.py
GEMINI_API_KEY=

# Platform service transactional mail (Brevo). The platform service reads the
# process environment; on the central host these live in /etc/scoot/platform.env.
# Restricted Brevo key with the "Transactional email" permission only.
BREVO_API_KEY=
PLATFORM_MAIL_SENDER=
PLATFORM_MAIL_ENABLED=false
# brevo sends through Brevo. stub sends nothing and records each message, with
# its rendered copy, in the file named by PLATFORM_MAIL_STUB_FILE (E2E runs).
PLATFORM_MAIL_TRANSPORT=brevo
PLATFORM_MAIL_STUB_FILE=
# JSON map from template name to Brevo template id, for example {"invitation": 12}.
# Startup fails when a template name has no id.
PLATFORM_BREVO_TEMPLATE_IDS=
PLATFORM_OPS_EMAIL=
# Shared secret that Brevo sends with each transactional webhook call, as
# "Authorization: Bearer <secret>" or as the password of basic auth. At least
# 24 characters. Unset means POST /v1/mail/brevo-events answers 503.
PLATFORM_BREVO_WEBHOOK_SECRET=
# https address of the company dashboard. Password reset and email
# verification links for dashboard users continue to <address>/w/<workspace>.
# Unset means the links have no continue address.
PLATFORM_DASHBOARD_URL=
PLATFORM_ACCOUNT_LINK_ADDRESS_LIMIT_PER_HOUR=5
PLATFORM_ACCOUNT_LINK_NETWORK_LIMIT_PER_HOUR=30
PLATFORM_SCHEDULER_PASSWORD_WATCH_SECONDS=900
PLATFORM_STAFF_EMAILS=
