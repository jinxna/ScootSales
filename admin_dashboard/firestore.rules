    }
    function validGrantList(value) { return value is list && value.size() <= 200; }
    function validAccessConfigWrite(docId, data, previous) {
      let roles = data.get('roles', null);
      return docId == 'permission_matrix' && data.keys().hasOnly([ 'roles', 'revision', 'updatedByUid', 'updatedByName',
          'updatedByEmail', 'updatedAt', 'auditDocumentId' ]) && data.keys().hasAll([ 'roles', 'revision', 'updatedByUid', 'updatedAt', 'auditDocumentId' ]) &&
          data.updatedByUid == request.auth.uid && data.updatedAt == request.time && data.revision is int && ( previous == null ? data.revision == 1
          : data.revision == previous.get('revision', 0) + 1 ) && roles is map && roles.keys().hasOnly(['admin', 'branch_manager', 'supervisor']) &&
          mirrorRevisionMatches('supervisor', data.revision) && mirrorRevisionMatches('branch_manager', data.revision) &&
          (!roles.keys().hasAny(['admin']) || validGrantList(roles['admin'])) && (!roles.keys().hasAny(['branch_manager']) ||
          validGrantList(roles['branch_manager'])) && (!roles.keys().hasAny(['supervisor']) || validGrantList(roles['supervisor'])) &&
          validPermissionConfigAudit(data);
    }
    allow read: if isAdminProfile();
    allow create: if isAdminProfile() && validAccessConfigWrite(docId, request.resource.data, null);
    allow update: if isAdminProfile() && validAccessConfigWrite(docId, request.resource.data, resource.data);
    allow delete: if false;
  }
  match /role_permission_grants/{docId} {
    function matrixTokens() {
      return [ 'products:view', 'products:create', 'products:edit', 'products:delete', 'departments:view', 'departments:create', 'departments:edit',
          'departments:delete', 'categories:view', 'categories:create', 'categories:edit', 'categories:delete', 'retailer_scoresheets:view',
          'retailer_scoresheets:create', 'retailer_scoresheets:edit', 'retailer_scoresheets:delete', 'department_pic:view', 'department_pic:create',
          'department_pic:edit', 'department_pic:delete', 'website_pages:view', 'website_pages:create', 'website_pages:edit', 'website_pages:delete' ];
    }
    function matrixDocumentPath() { return /databases/$(database)/documents/system_access_config/permission_matrix; }
    function viewBacksWrites(module, grants) {
      return (module + ':view') in grants || !((module + ':create') in grants || (module + ':edit') in grants || (module + ':delete') in grants);
    }
    function validGrantMirror(role, data) {
      let matrix = getAfter(matrixDocumentPath()).data;
      let row = matrix.get('roles', {}).get(role, null);
      let grants = data.get('grants', null);
      return role in ['supervisor', 'branch_manager'] && existsAfter(matrixDocumentPath()) &&
          exactKeys(data, [ 'role', 'grants', 'revision', 'updatedByUid', 'updatedAt', 'shape' ]) && data.shape == 3 && data.role == role && data.revision == matrix.revision &&
          data.updatedByUid == request.auth.uid && data.updatedAt == request.time && grants is list && grants.size() <= 24 && row is list &&
          grants.hasOnly(matrixTokens()) && grants.hasOnly(row) && row.hasOnly(grants) && viewBacksWrites('products', grants) && viewBacksWrites('departments', grants) &&
          viewBacksWrites('categories', grants) && viewBacksWrites('retailer_scoresheets', grants) && viewBacksWrites('department_pic', grants) &&
          viewBacksWrites('website_pages', grants);
    }
    function canReadGrantMirror(actor) { return isAdminFor(actor) || (isDashboardRoleFor(actor) && actor.get('role', '') == docId); }
    allow get: if canReadGrantMirror(caller());
    allow create, update: if isAdminProfile() && validGrantMirror(docId, request.resource.data);
    allow delete: if false;
  }
  match /config/{docId} {
    allow read: if (docId == 'plan' || docId == 'lifecycle') ? isCompanyMember() : docId == 'usage' ? isAdminProfile() : false;
    allow write: if false;
  }
  match /{collection}/{document=**} {
    allow read, write: if false;
  }
}
}
}
