  function validTrackingLocation(data) {
    return validCapturedLocation(data) && data.keys().hasAll(['timestamp', 'updatedAt']) && data.timestamp == request.time && data.updatedAt == request.time;
  }
  function isOwnSalesmanRecord(data) {
    return signedIn() && ( text(data, 'salesmanUid', 'salesman_uid') == request.auth.uid || text(data, 'uid', 'userUid') == request.auth.uid ||
        text(data, 'submittedByUid', 'createdByUid') == request.auth.uid );
  }
  function activityIdentityKeys() {
    return [ 'salesmanUid', 'salesman_uid', 'uid', 'userUid', 'submittedByUid', 'createdByUid', 'salesmanCode', 'salesman_code', 'salesmanId',
        'salesman_id', 'staffId', 'employeeCode', 'branchId', 'branch_id' ];
