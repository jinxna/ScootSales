  }
  function scopedSalesmanIdOrStaff(data) {
    let id = text(data, 'salesmanId', 'salesman_id');
    return id != '' ? id : text(data, 'staffId', 'employeeCode');
  }
  function canReadScopedSalesmanRecord(data) {
    let actor = caller();
    return managesScope(actor, scopedSalesmanCode(data), routeBranchId(data)) || ( actor._active == true &&
        actor.role == 'salesman' && isOwnSalesmanRecord(data) );
  }
  function canReadOwnOrManagedRecord(data) { return (isOwnSalesmanRecord(data) && accountNotSuspended()) || ownCodeOrManagedRecord(data, caller()); }
  function ownCodeOrManagedRecord(data, actor) {
    return ( actor._active == true && actor.role == 'salesman' && ownerlessCodeMatch(data, actor) ) || canManageRouteFor(data, actor);
  }
  function hasNoOwnerUid(data) {
    return data.get('salesmanUid', '') == '' && data.get('salesman_uid', '') == '' && data.get('uid', '') == '' && data.get('userUid', '') == '' &&
        data.get('submittedByUid', '') == '';
  }
  function ownerlessCodeMatch(data, actor) {
    return actor.get('salesmanCode', '') != '' && text(data, 'salesmanCode', 'salesman_code') == actor.get('salesmanCode', '') && hasNoOwnerUid(data) &&
        (request.method == 'get' || data.get('salesmanUid', null) == '');
  }
  function validOwnSalesmanTracking(data) {
    let actor = caller();
    let code = actor.get('salesmanCode', '');
    let branch = actor.get('branchId', '');
    let u = request.auth.uid;
    let owner = data.diff({'salesmanUid': u, 'salesman_uid': u, 'uid': u, 'userUid': u, 'submittedByUid': u, 'createdByUid': u});
    return actor._active == true && actor.role == 'salesman' && owner.changedKeys().size() == 0 && owner.unchangedKeys().size() > 0 && ( code == '' ||
        text(data, 'salesmanCode', 'salesman_code') == code ) && ( branch == '' || text(data, 'branchId', 'branch_id') == branch );
  }
  function boundedTrackingIdentity(data) {
    return (data.get('salesmanId', '') + data.get('salesmanName', '') + data.get('salesmanEmail', '') + data.get('submittedByEmail', '') +
        data.get('submittedByName', '') + data.get('staffId', '') + data.get('employeeCode', '') + data.get('salesman_code', '')).size() <= 2000;
  }
  function dataRoutePath(data) { return /databases/$(database)/documents/route_plans/$(data.planId); }
  function dataRetailerPath(data) { return /databases/$(database)/documents/retailers/$(data.retailerId); }
  function trackingModeAllowed(mode) { return mode in ['live', 'standard', 'battery_saver']; }
  function validWorkSessionId(data) { return data.activeSessionId is string && data.activeSessionId.matches('^[0-9a-f]{32}$'); }
  match /orders/{orderId} {
    function orderAuditPath(orderDocumentId) { return /databases/$(database)/documents/order_audit_logs/$(orderDocumentId); }
    function validAtomicOrderDelete(orderId, order, actor) {
      let audit = orderAuditPath(orderId);
      return isAdminFor(actor) && (actor.get('role', '') == 'developer' || orderAuditPreviousStatus(order) == 'draft') && !exists(audit) &&
          existsAfter(audit) && validOrderAudit(orderId, getAfter(audit).data, order, actor.get('role', ''));
    }
    function validOptionalEvidenceFix(evidence) {
      let hasFix = evidence.keys().hasAny([ 'latitude', 'longitude', 'accuracyMeters', 'deviceCapturedAt', 'isMocked' ]);
      return !hasFix || ( validLocationFix(evidence, 10000) );
    }
    function validOrderLocation(data) {
      let names = data.keys();
      let hasCoordinates = names.hasAny([ 'latitude', 'longitude', 'gpsLatitude', 'gpsLongitude', 'location' ]);
      let hasEvidence = names.hasAny(['locationEvidence']);
      return !hasCoordinates ? ( !hasEvidence || data.locationEvidence is map && data.locationEvidence.mode == 'not_verified' &&
          validOptionalEvidenceFix(data.locationEvidence) ) : ( names.hasAll([ 'latitude', 'longitude', 'gpsLatitude', 'gpsLongitude',
          'location', 'accuracy', 'accuracyMeters', 'deviceCapturedAt', 'isMocked', 'locationVerification', 'locationEvidence' ]) &&
          validCapturedLocation(data) && data.locationCapturedAt == request.time && data.locationEvidence is map &&
          data.locationEvidence.mode == data.locationVerification && data.locationEvidence.latitude == data.latitude &&
          data.locationEvidence.longitude == data.longitude && data.locationEvidence.accuracyMeters == data.accuracyMeters &&
          data.locationEvidence.deviceCapturedAt == data.deviceCapturedAt && data.locationEvidence.isMocked == data.isMocked );
    }
    function canReadOrder(data) { return (isOwnSalesmanRecord(data) && accountNotSuspended()) || canReadOrderAs(data, caller()); }
    function canReadOrderAs(data, actor) {
      return managesScope(actor, scopedSalesmanCode(data), routeBranchId(data)) || ( actor._active == true &&
          actor.role == 'salesman' && actor.salesmanCode != '' && routeSalesmanCode(data) == actor.salesmanCode );
    }
    function validCommercialOrderLines(data) {
      let joined = data.commercialLines.join(',');
      return data.commercialSchemaVersion == 1 && data.commercialLines is list && data.commercialLines.size() >= 1 && data.commercialLines.size() <= 25 &&
          joined.size() <= 25500 && joined.matches(
          '^([A-Za-z0-9_-]{1,200}~[A-Za-z0-9_-]{1,800}~[1-9][0-9]{0,2}~[1-9][0-9]{0,8},){0,24}[A-Za-z0-9_-]{1,200}~[A-Za-z0-9_-]{1,800}~[1-9][0-9]{0,2}~[1-9][0-9]{0,8}$' );
    }
    function validSubmittedOrder(orderId) {
      let data = request.resource.data;
      return data.orderId == orderId && data.visitSource in ['assigned_route', 'personal_planner'] && data.retailerId is string &&
          data.retailerId.trim() != '' && data.retailerId.size() <= 200 && data.items is list && data.items.size() >= 1 && data.items.size() <= 25 &&
          validCommercialOrderLines(data) && data.commercialLines.size() == data.items.size() && data.totalProducts == data.commercialLines.size() &&
          data.totalBoxes is int && data.totalBoxes >= 1 && data.totalBoxes <= 24975 && data.totalPrice is number && data.totalPrice > 0 &&
          data.totalPrice <= 10000000 && [ data.submittedAt, data.createdAt, data.updatedAt ] == [ request.time, request.time, request.time ] &&
          data.status == 'submitted' && !('serverPriceCheck' in data);
    }
    function validOrderForApproval() {
      let data = resource.data;
      return data.keys().hasAll([ 'retailerId', 'items', 'totalBoxes', 'totalPrice' ]) && data.retailerId is string && data.retailerId.trim() != '' &&
          data.items is list && data.items.size() >= 1 && data.items.size() <= 25 && data.totalBoxes is int && data.totalBoxes >= 1 &&
          data.totalPrice is number && data.totalPrice > 0 && (data.get('commercialSchemaVersion', 0) != 1 || ( validCommercialOrderLines(data) &&
          data.commercialLines.size() == data.items.size() && data.get('totalProducts', data.commercialLines.size()) == data.commercialLines.size() ));
    }
    function hasAssignedVisitOrderIdentity(data) {
      return data.keys().hasAny(['routePlanId', 'routeStopId']) || text(data, 'visitSource', 'visit_source') == 'assigned_route';
    }
    function isCanonicalAssignedVisitOrder(orderId, actor) {
      let data = request.resource.data;
      let routePath = /databases/$(database)/documents/route_plans/$(data.routePlanId);
      let suffix = data.salesmanUid + '.' + data.routePlanId + '.' + data.routeStopId;
      return data.visitSource == 'assigned_route' && suffix.matches('^[A-Za-z0-9_-]{1,128}[.][A-Za-z0-9_-]{1,100}[.][A-Za-z0-9_-]{1,300}$') &&
          exists(routePath) && assignedRouteMatchesOrder(get(routePath).data, data, actor) && orderId == 'ORD-V2-' + suffix;
    }
    function validOrderCreateShape(data) {
      let names = data.keys();
      let keys = names.join(',');
      return (keys + ',').matches('^(?:(?:orderId|visitId|visitSource|routePlanId|routeStopId|retailerId|retailerName|outlet|uid|userUid|salesmanUid|salesmanEmail|salesmanId|salesmanCode|salesmanName|submittedByUid|createdByUid|branchId|supervisorId|totalProducts|totalBoxes|totalPrice|submittedAt|createdAt|updatedAt|status|items|commercialSchemaVersion|commercialLines|signatureTimestamps|locationEvidence|latitude|longitude|gpsLatitude|gpsLongitude|location|locationCapturedAt|accuracy|accuracyMeters|deviceCapturedAt|isMocked|locationVerification),)+$') &&
          names.size() == keys.split(',').size() && (data.get('retailerName', '') + data.get('outlet', '') + data.get('salesmanName', '') +
          data.get('salesmanEmail', '') + data.get('supervisorId', '') + data.get('visitId', '')).size() <= 2000 && data.get('salesmanId', '').size() <= 100 &&
          validSignatureTimestamps(data.get('signatureTimestamps', {})) && data.get('locationEvidence', {}).get('failureCode', '').matches('^[a-z_]{0,40}$');
    }
    function validSignatureTimestamps(stamps) {
      return stamps.size() <= 30 && stamps.values().join('|').matches('^[0-9 /:.TZ|-]{0,1000}$');
    }
    function assignedRouteMatchesOrder(route, data, actor) {
      return isOwnPublishedRoute(route, actor) && ( !('stopRetailerIds' in route) ||
