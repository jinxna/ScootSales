        supervisorRouteBound(route, actor.assignedSalesmanCodes) ) );
  }
  function supervisorRouteBound(route, team) {
    let uid = routeSalesmanUid(route);
    let code = routeSalesmanCode(route);
    return uid == '' ? codeInTeam(code, team) : (codeInTeam(code, team) || codeInTeam(uid, team)) && salesmanCodeOfUid(uid) == code;
  }
  function salesmanCodeOfUid(uid) {
    let accessPath = /databases/$(database)/documents/user_access/$(uid);
    return exists(accessPath) ? accessRecordCode(get(accessPath).data) : profileCode(uid);
  }
  function accessRecordCode(access) {
    let version = access.get('accessVersion', null);
    return version == 2 ? access.get('employeeCode', '') : version != null ? '' : access.keys().hasAny(['userDocId', 'user_doc_id'])
        ? profileCode(text(access, 'userDocId', 'user_doc_id')) : legacyCode(access);
  }
  function profileCode(profileId) {
    return profileId != '' && exists(/databases/$(database)/documents/users/$(profileId))
        ? legacyCode(get(/databases/$(database)/documents/users/$(profileId)).data) : '';
  }
  function legacyCode(record) {
    let code = text(record, 'employeeCode', 'staffId');
    return code != '' ? code : text(record, 'salesmanCode', 'salesman_code');
  }
  function canManageRouteFor(route, actor) {
    return actor._active == true && ( actor.role in ['admin', 'developer'] || ( actor.role == 'supervisor' && (
        codeInTeam(routeSalesmanCode(route), actor.assignedSalesmanCodes) || codeInTeam(routeSalesmanUid(route), actor.assignedSalesmanCodes) ) ) || (
        actor.role == 'branch_manager' && actor.branchId != '' && routeBranchId(route) == actor.branchId ) );
  }
  function validLatLng(lat, lng) { return lat is number && lat >= -90 && lat <= 90 && lng is number && lng >= -180 && lng <= 180 && !(lat == 0 && lng == 0); }
  function validLocationFix(data, maxAccuracy) {
    let latitude = data.get('latitude', null);
    let longitude = data.get('longitude', null);
    let accuracyMeters = data.get('accuracyMeters', null);
    let capturedAt = data.get('deviceCapturedAt', null);
    let mocked = data.get('isMocked', null);
    return validLatLng(latitude, longitude) && accuracyMeters is number && accuracyMeters >= 0 && accuracyMeters <= maxAccuracy && capturedAt is timestamp &&
        capturedAt <= request.time + duration.value(5, 'm') && mocked is bool;
  }
  function recentFix(data) { return data.deviceCapturedAt >= request.time - duration.value(7, 'd'); }
  function validCapturedLocation(data) {
    return validLocationFix(data, 100) && data.gpsLatitude == data.latitude && data.gpsLongitude == data.longitude && data.location is latlng &&
        data.accuracy is number && data.accuracy == data.accuracyMeters && data.isMocked == false &&
