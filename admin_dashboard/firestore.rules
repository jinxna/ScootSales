      allow delete: if false;
    }
  }
  match /scenario_run_access/{accessId} {
    function validScenarioAccessIndex(uid, runId, data) {
      return data.keys().hasOnly([ 'uid', 'runId', 'role', 'branchId', 'salesmanUid', 'salesmanCode', 'assignedSalesmanCodes' ]) && data.keys().size() == 7 &&
          data.uid == uid && uid.size() > 0 && data.runId == runId && data.role in [ 'admin', 'developer', 'supervisor', 'branch_manager', 'salesman' ] &&
          data.branchId is string && data.salesmanUid is string && data.salesmanCode is string && data.assignedSalesmanCodes is list && (
          data.role != 'salesman' || (data.salesmanUid == uid && data.salesmanCode.size() > 0 && data.branchId.size() > 0) ) &&
          (data.role != 'branch_manager' || data.branchId.size() > 0);
    }
    function scenarioCanCreateAccessIndex(accessId, data) {
