      return collection in [ 'weekly_coverage', 'activity_weeks', 'orders', 'visits', 'conversation_outcomes', 'plans', 'route_plan_progress',
          'route_stop_progress', 'forecasts' ];
    }
    function scenarioCanReadChild(runId, collection, data) {
      let actor = caller();
      let role = actor.get('role', '');
      return scenarioChildCollectionAllowed(collection) && data.get('scenarioRunId', '') == runId && data.get('synthetic', false) == true &&
          scenarioHasReadyRunAccess(runId, actor) && ( role in ['admin', 'developer'] || ( role == 'salesman' &&
          data.get('salesmanUid', '') == request.auth.uid && data.get('salesmanCode', '') == actor.salesmanCode &&
          data.get('branchId', '') == actor.branchId && ( collection != 'weekly_coverage' || data.get('scopeType', '') == 'salesperson' ) ) || (
          role == 'supervisor' && actor.branchId != '' && data.get('branchId', '') == actor.branchId &&
          data.get('salesmanCode', '') is string && data.get('salesmanCode', '') in actor.assignedSalesmanCodes ) || ( role == 'branch_manager' &&
          actor.branchId != '' && data.get('branchId', '') == actor.branchId ) );
    }
    function scenarioCanSeedChild(runId, collection, data) {
      let actor = caller();
      return scenarioChildCollectionAllowed(collection) && scenarioAdminSeedActor(actor) && scenarioRunHasState(runId, 'preparing') &&
