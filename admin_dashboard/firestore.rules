          'productIds', 'productCount', 'status', 'sourceRetailerId', 'sourceRetailerName', 'copiedFromTemplateId', 'copiedFromRevision', 'copiedFromName',
          'previousRevision', 'createdByUid', 'createdAt' ]) && nonEmptyText(data.templateId, 100) &&
          data.revision is int && data.revision >= 1 && data.revision <= 100000 && docId == data.templateId + '_r' + string(data.revision) &&
          nonEmptyText(data.name, 200) && ids is list && ids.size() > 0 &&
