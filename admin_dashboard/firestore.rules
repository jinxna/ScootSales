        data.get('salesmanUid', uid) == uid && data.get('salesman_uid', uid) == uid && data.get('uid', uid) == uid && data.get('userUid', uid) == uid &&
        data.get('submittedByUid', uid) == uid && data.get('createdByUid', uid) == uid && data.get('salesmanCode', code) == code &&
        data.get('salesman_code', code) == code && data.get('salesmanId', code) == code && data.get('salesman_id', code) == code &&
        data.get('staffId', code) == code && data.get('employeeCode', code) == code && data.get('branchId', branch) == branch &&
        data.get('branch_id', branch) == branch;
  }
  function canCreateActivityRecord(data, actor) {
    return isAdminFor(actor) || (isDashboardRoleFor(actor) && !data.keys().hasAny(activityIdentityKeys())) || isOwnActivityRecord(data, actor);
  }
  function canReadPreciseLocation(data) {
    let actor = caller();
    return managesScope(actor, routeSalesmanCode(data), routeBranchId(data)) || ( actor._active == true &&
        actor.role == 'salesman' && isOwnSalesmanRecord(data) );
  }
  function scopedSalesmanCode(data) {
    let code = text(data, 'salesmanCode', 'salesman_code');
