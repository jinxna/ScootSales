          data.get('productCount', ids.size()) == ids.size() && data.get('status', 'active') == 'active' &&
          boundedText(data, 'sourceRetailerId', 200) && boundedText(data, 'sourceRetailerName', 200) && boundedText(data, 'copiedFromTemplateId', 100) &&
          data.get('copiedFromRevision', 0) is int && boundedText(data, 'copiedFromName', 200) && data.get('previousRevision', 0) is int &&
          data.get('createdByUid', request.auth.uid) == request.auth.uid && data.get('createdAt', request.time) == request.time;
    }
    allow create: if moduleAction('retailer_scoresheets', 'create') && (request.resource.data.get('kind', '') != 'template' ||
        validScoreSheetTemplate(docId, request.resource.data));
    function validScoreSheetTemplateRetire() {
      let next = request.resource.data;
