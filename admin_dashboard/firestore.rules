      return changed.hasOnly([ 'status', 'handledStopIds', 'lastStopId', 'lastStopStatus', 'lastStopEventId', 'lastSummaryWorkSessionGeneration',
          'lastSummaryEventSequence', 'lastStopWriteStopId', 'lastStopWriteStatus', 'lastStopWriteEventId',
          'lastStopWriteWorkSessionGeneration', 'lastStopWriteSequence', 'selectedStopId', 'selectionRevision', 'routeSessionState', 'updatedAt', 'lastSyncedAt'
          ]) &&
          ( !('routeSessionState' in changed) || ( data.status == 'completed' && data.routeSessionState == 'completed' &&
          oldData.routeSessionState in ['active', 'paused'] ) ) && stopId.size() > 0 && ( data.lastStopWriteStatus == 'arrived'
          ? validCanonicalArrivalParentProjection( route, data, oldData, stop, stopExists, stopId ) : validCanonicalStopHandledProjection(
          route, changed, data, oldData, stop, stopExists, stopId ) );
    }
    function validProgressUpdate(route, changed, data, oldData) {
      return changed.hasOnly([ 'status', 'acceptedAt', 'startedAt', 'completedAt', 'routeSessionState', 'updatedAt', 'lastSyncedAt' ]) && (
          data.get('acceptedAt', null) == oldData.get('acceptedAt', null) || data.get('acceptedAt', null) == request.time ) && (
          data.get('startedAt', null) == oldData.get('startedAt', null) || data.get('startedAt', null) == request.time ) && (
          data.get('completedAt', null) == oldData.get('completedAt', null) || data.get('completedAt', null) == request.time ) && (data.status == 'completed'
          ? validRouteCompletion(route) : true);
    }
    function validRouteCompletion(route) {
      return request.resource.data.handledStopIds is list && request.resource.data.handledStopIds.toSet() == route.stopIds.toSet();
    }
    allow read: if signedIn() && canReadRouteProgress(resource.data);
    allow create, update: if signedIn() && ( resource == null ? canCreateOwnRouteProgress(progressId) && request.resource.data.keys().hasOnly([
        'progressId', 'planId', 'salesmanUid', 'salesmanCode', 'branchId', 'isOfflineCreated', 'status', 'stopProgress', 'handledStopIds',
        'selectedStopId', 'selectionRevision', 'acceptedAt', 'updatedAt', 'lastSyncedAt' ]) : canUpdateOwnRouteProgress(progressId) );
    allow delete: if false;
  }
  match /route_plan_publication_keys/{keyId} {
    function publicationIdentity(route) {
      let uid = routeSalesmanUid(route);
      return uid != '' ? uid : routeSalesmanCode(route);
    }
    function publicationWeekKey(weekStart) {
      let local = weekStart + duration.value(8, 'h');
      return string(local.year()) + (local.month() < 10 ? '0' : '') + string(local.month()) + (local.day() < 10 ? '0' : '') + string(local.day());
    }
    function publicationKeyIdFor(route) { return publicationIdentity(route).replace('[^A-Za-z0-9_-]', '_') + '_' + publicationWeekKey(route.weekStart); }
    allow read: if canReadPublicationKey(caller());
    function canReadPublicationKey(actor) {
      return isDashboardRoleFor(actor) && ( resource == null || ( resource.data.planId is string && exists(
          /databases/$(database)/documents/route_plans/$(resource.data.planId) ) && canManageRouteFor( get(
          /databases/$(database)/documents/route_plans/$(resource.data.planId) ).data, actor ) ) );
    }
    allow create: if canCreatePublicationKey(keyId);
    function canCreatePublicationKey(keyId) {
      let next = request.resource.data;
      let actor = caller();
      let planPath = /databases/$(database)/documents/route_plans/$(next.planId);
      return isDashboardRoleFor(actor) && next.keyId == keyId && next.updatedByUid == request.auth.uid &&
          next.planId is string && exists(planPath) && publicationKeyMatchesPlan(get(planPath).data, actor, keyId) &&
          next.salesmanIdentity is string && next.weekKey is string;
    }
    function publicationKeyMatchesPlan(plan, actor, keyId) { return canWriteRouteFor(plan, actor) && keyId == publicationKeyIdFor(plan); }
    allow update: if canUpdatePublicationKey(keyId);
    function canUpdatePublicationKey(keyId) {
      let next = request.resource.data;
      let old = resource.data;
      let actor = caller();
      let oldPath = /databases/$(database)/documents/route_plans/$(old.planId);
      return old.planId is string && exists(oldPath) && next.keyId == keyId && next.updatedByUid == request.auth.uid &&
          canWriteRouteFor(get(oldPath).data, actor) && ( next.planId == old.planId
          ? next.diff(old).affectedKeys().hasOnly([ 'updatedByUid', 'updatedAt', 'active' ])
          : get(oldPath).data.status != 'published' && canTakeOverPublicationKey(keyId, actor) );
    }
    function canTakeOverPublicationKey(keyId, actor) {
      let next = request.resource.data;
      let newPath = /databases/$(database)/documents/route_plans/$(next.planId);
      return next.planId is string && exists(newPath) && publicationKeyMatchesPlan(get(newPath).data, actor, keyId) &&
          next.diff(resource.data).affectedKeys().hasOnly([ 'planId', 'updatedByUid', 'updatedAt', 'active', 'weekStart', 'salesmanUid', 'salesmanCode' ]);
    }
    allow delete: if false;
  }
  match /route_stop_progress/{stopDocId} {
    function canReadStopEvidence(data) {
      let actor = caller();
      return actor._active == true && ( actor.role in ['admin', 'developer'] || ( actor.role == 'salesman' &&
          data.get('salesmanUid', '') == request.auth.uid ) || ( actor.role == 'supervisor' && data.get('salesmanCode', '') in
          actor.assignedSalesmanCodes ) || ( actor.role == 'branch_manager' && actor.branchId != '' &&
          data.get('branchId', '') == actor.branchId ) );
    }
    function canGetMissingStopEvidence(stopDocId) {
      let actor = caller();
      return actor._active == true && isCanonicalMissingStopGet(stopDocId);
    }
    function stopDocIdentity(stopDocId, data) {
      return data.salesmanUid == request.auth.uid && stopDocId == canonicalStopDocId(data.planId, data.stopId);
    }
    function validV2StopIdentity(stopDocId, data) {
      return stopDocIdentity(stopDocId, data) && data.salesmanCode is string && data.salesmanCode.size() > 0 && data.branchId is string &&
          data.retailerId is string && data.retailerId.size() > 0 && data.lifecycleSchemaVersion == 2;
    }
    function validV2StopSessionEvent(data, eventId, status) {
      let livePath = /databases/$(database)/documents/live_tracking/$(request.auth.uid);
      let live = get(livePath).data;
      return data.workSessionId.matches('^[0-9a-f]{32}$') && data.workSessionGeneration is int && data.workSessionGeneration > 0 &&
          data.sessionEventSequence is int && data.sessionEventSequence > 0 && eventId == data.workSessionId + '_' + data.stopId + '_' + status &&
          eventId.size() <= 100 && data.deviceOccurredAt <= request.time + duration.value(60, 'm') && data.receivedAt == request.time &&
          data.updatedAt == request.time && live.uid == request.auth.uid && live.workSessionStatus == 'active' && live.activeSessionId == data.workSessionId &&
          live.activeSessionGeneration == data.workSessionGeneration;
    }
    function validArrivalDistance(data, referenceLatitude, referenceLongitude) {
      let measuredDistance = latlng.value( data.arrivalLatitude, data.arrivalLongitude ).distance(latlng.value(referenceLatitude, referenceLongitude));
      return measuredDistance <= 75 && data.arrivalDistanceMeters <= 75 && data.arrivalDistanceMeters >= 0;
    }
    function validCurrentRetailerCoordinates(data) {
      let retailerPath = /databases/$(database)/documents/retailers/$(data.retailerId);
      let retailer = exists(retailerPath) ? get(retailerPath).data : {};
      let coordinateStatus = retailer.get('coordinateStatus', '').lower();
      let reviewStatus = retailer.get('coordinateReviewStatus', '').lower();
      let coordinateSource = retailer.get('coordinateSource', '');
      let latitude = retailer.get('latitude', retailer.get('lat', retailer.get('gpsLatitude', retailer.get('gps_latitude', null))));
      let longitude = retailer.get('longitude', retailer.get('lng', retailer.get('gpsLongitude', retailer.get('gps_longitude', null))));
      return ( coordinateStatus == 'verified' || (coordinateStatus == '' && (reviewStatus in ['reviewed', 'verified'] || coordinateSource == 'admin_review'))
          ) && validLatLng(latitude, longitude) && coordinateSource == data.retailerCoordinateSource && validArrivalDistance(data, latitude, longitude);
    }
    function validPublishedSnapshotArrivalEvidence(data) {
      let route = get( /databases/$(database)/documents/route_plans/$(data.planId) ).data;
      let stopSnapshots = route.get('stopCoordinateSnapshots', {});
      let snapshot = stopSnapshots is map ? stopSnapshots.get(data.stopId, {}) : {};
      return route.get('publishedAt', null) is timestamp && routeOpenToSalesman(route) && data.coordinateSnapshotAt == route.publishedAt &&
          data.coordinateSnapshotAt <= request.time && route.get('stopRetailerIds', {}).get(data.stopId, '') == data.retailerId && snapshot is map &&
          snapshot.get('retailerId', '') == data.retailerId && snapshot.get('coordinateStatus', '').lower() == 'verified' &&
          validLatLng(snapshot.get('latitude', null), snapshot.get('longitude', null)) &&
          snapshot.get('coordinateRevision', '') == data.retailerCoordinateRevision && snapshot.get('coordinateSource', '') == data.retailerCoordinateSource &&
          validArrivalDistance(data, snapshot.latitude, snapshot.longitude);
    }
    function validV2ArrivalEvidence(data) {
      return data.arrivalMode in ['location_verified', 'manual_unverified'] && data.arrivalEventId == data.eventId && data.arrivedAt is timestamp &&
          data.arrivedAt == data.arrivalDeviceOccurredAt && data.arrivalDeviceOccurredAt == data.deviceOccurredAt &&
          data.arrivalWorkSessionId == data.workSessionId && data.arrivalWorkSessionGeneration == data.workSessionGeneration &&
          data.arrivalSessionEventSequence == data.sessionEventSequence && data.arrivalReceivedAt == request.time && ( data.arrivalMode == 'location_verified'
          ? data.coordinateReferenceMode in [ 'current_retailer', 'published_snapshot_offline' ] && data.retailerCoordinateRevision.size() > 0 &&
          data.retailerCoordinateRevision.size() <= 1024 && data.retailerCoordinateSource.size() <= 100 &&
          validLatLng(data.arrivalLatitude, data.arrivalLongitude) &&
          data.arrivalAccuracyMeters is number && data.arrivalAccuracyMeters >= 0 && data.arrivalAccuracyMeters <= 25 && data.arrivalDistanceMeters is number &&
          data.arrivalDistanceMeters >= 0 && data.arrivalDistanceMeters <= 75 && data.arrivalDeviceCapturedAt is timestamp &&
          data.arrivalDeviceCapturedAt == data.deviceOccurredAt && data.arrivalIsMocked == false && !('arrivalFailureCode' in data) && (
          data.coordinateReferenceMode == 'current_retailer' ? data.coordinateCheckedAt is timestamp &&
          data.coordinateCheckedAt <= request.time + duration.value(60, 'm') && validCurrentRetailerCoordinates(data)
          : data.coordinateSnapshotAt is timestamp && validPublishedSnapshotArrivalEvidence(data) ) : data.coordinateReferenceMode == 'unverified' &&
          data.retailerCoordinateRevision == '' && data.retailerCoordinateSource == '' && 'arrivalFailureCode' in data &&
          data.arrivalFailureCode.matches('^(disabled_by_user|service_disabled|permission_denied|permission_denied_forever|unavailable|invalid_coordinates|stale|inaccurate|mocked|missing_retailer_coordinates|outside_radius)$') &&
          data.overrideReasonCode.matches('^(gps_unavailable|retailer_coordinates_incorrect|manager_approved_exception|safety_or_access_issue)$') && data.overrideNote is string &&
          data.overrideNote.size() >= 3 && data.overrideNote.size() <= 300 ) && data.keys().hasOnly([ 'planId', 'salesmanUid', 'salesmanCode', 'branchId',
          'stopId', 'retailerId', 'retailerName', 'lifecycleSchemaVersion', 'status', 'eventId', 'workSessionId', 'workSessionGeneration',
          'sessionEventSequence', 'deviceOccurredAt', 'receivedAt', 'updatedAt', 'arrivedAt', 'arrivalEventId',
          'arrivalWorkSessionId', 'arrivalWorkSessionGeneration', 'arrivalSessionEventSequence', 'arrivalDeviceOccurredAt',
          'arrivalReceivedAt', 'arrivalMode', 'arrivalFailureCode', 'overrideReasonCode', 'overrideNote', 'arrivalLatitude',
          'arrivalLongitude', 'arrivalAccuracyMeters', 'arrivalDeviceCapturedAt', 'arrivalIsMocked', 'arrivalDistanceMeters', 'retailerCoordinateRevision',
          'retailerCoordinateSource', 'coordinateReferenceMode', 'coordinateSnapshotAt', 'coordinateCheckedAt',
          'completedAt', 'skippedAt', 'skipReason', 'notes', 'legacyArrivalEvidence' ]);
    }
    function stopEntryStatus(parent, stopId) {
      let entries = parent.get('stopProgress', {});
      let entry = entries is map ? entries.get(stopId, {}) : {};
      return entry is map ? entry.get('status', '') : '';
    }
    function validV2StopLifecycleCreate(data, isArrival, isCompleted, isSkipped) {
      let parentPath = /databases/$(database)/documents/route_plan_progress/$(data.planId + '_' + request.auth.uid);
      let parent = exists(parentPath) ? get(parentPath).data : {};
      let entryStatus = stopEntryStatus(parent, data.stopId);
      return !(entryStatus in ['completed', 'skipped']) && ( isArrival ? parent.get('selectedStopId', '') == data.stopId && validV2ArrivalEvidence(data)
          : isSkipped ? data.skipReason is string && data.skipReason.size() > 0 && data.skipReason.size() <= 300 : isCompleted && entryStatus == 'arrived' );
    }
    function validStopParentAfterProjection(data) {
      let parentPath = /databases/$(database)/documents/route_plan_progress/$(data.planId + '_' + request.auth.uid);
      let parent = getAfter(parentPath).data;
      return parent.salesmanCode == data.salesmanCode && parent.get('branchId', '') == data.branchId && parent.get('lastStopWriteStopId', '') == data.stopId &&
          parent.lastStopWriteStatus == data.status && parent.lastStopWriteEventId == data.eventId && parent.lastStopWriteWorkSessionGeneration ==
          data.workSessionGeneration && parent.lastStopWriteSequence == data.sessionEventSequence && parent.updatedAt == request.time &&
          parent.lastSyncedAt == request.time;
    }
    function validV2StopLifecycleUpdate(data, status) {
      let old = resource.data;
      let changed = data.diff(old).affectedKeys();
      let isCompleted = status == 'completed';
      let isSkipped = status == 'skipped';
      let oldStatus = old.get('status', '');
      let oldGeneration = old.get('workSessionGeneration', 0);
      let oldSequence = old.get('sessionEventSequence', 0);
      let exactReplay = oldStatus == status && old.get('lifecycleSchemaVersion', 0) == 2 && old.get('eventId', '') == data.eventId &&
          oldGeneration == data.workSessionGeneration && oldSequence == data.sessionEventSequence &&
          old.get('deviceOccurredAt', null) == data.deviceOccurredAt && changed.hasOnly(['receivedAt', 'updatedAt']);
      return exactReplay || (oldStatus == 'arrived' && (isCompleted || isSkipped) && data.workSessionGeneration >= oldGeneration &&
          (data.workSessionGeneration > oldGeneration || (data.workSessionId == old.get('workSessionId', '') && data.sessionEventSequence > oldSequence)) &&
          changed.hasOnly([
          'lifecycleSchemaVersion', 'status', 'eventId', 'workSessionId', 'workSessionGeneration', 'sessionEventSequence', 'deviceOccurredAt', 'receivedAt',
          'updatedAt', 'completedAt', 'skippedAt', 'skipReason', 'notes']) && (isCompleted ? data.completedAt == data.deviceOccurredAt
          : data.skippedAt == data.deviceOccurredAt && data.skipReason is string && data.skipReason.size() > 0 && data.skipReason.size() <= 300));
    }
    function validV2StopLifecycleMutation(stopDocId, data) {
      let status = data.status;
      return status in ['arrived', 'completed', 'skipped'] && validV2StopIdentity(stopDocId, data) &&
          validV2StopSessionEvent(data, data.eventId, status) && validStopParentAfterProjection(data) &&
          (resource == null ? validV2StopLifecycleCreate(data, status == 'arrived', status == 'completed', status == 'skipped')
          : validV2StopLifecycleUpdate(data, status));
    }
    function isCanonicalMissingStopGet(stopDocId) {
      return request.auth.uid.matches('^[A-Za-z0-9_-]+$') && stopDocId.matches( '^.*_' + identityPathPart(request.auth.uid) + '_.*$' );
    }
    allow get: if signedIn() && ( resource == null ? canGetMissingStopEvidence(stopDocId) : canReadStopEvidence(resource.data) );
    allow list: if signedIn() && canReadStopEvidence(resource.data);
    allow create, update: if signedIn() && validV2StopLifecycleMutation(stopDocId, request.resource.data);
    allow delete: if false;
  }
}

match /documents {
  function lockRequestPath(id) { return /databases/$(database)/documents/account_lock_requests/$(id); }
  function lockReceiptPath(id) { return /databases/$(database)/documents/account_lock_receipts/$(id); }
  function lockLimitPath(email) { return /databases/$(database)/documents/account_lock_limits/$(identityPathPart(email)); }
  function lockWindowId() { return 'h' + string(int(request.time.toMillis() / 3600000)); }
  function lockWindowPath() { return /databases/$(database)/documents/account_lock_windows/$(lockWindowId()); }
  function lockReportAuditPath(id) { return /databases/$(database)/documents/system_audit_logs/$('lock_request_' + id); }
  function lockUnlockAuditPath(id) { return /databases/$(database)/documents/system_audit_logs/$('lock_unlock_' + id); }
  function validLockId(id) { return id is string && id.matches('^[a-f0-9]{64}$'); }
  function activeLockAdmin() { return signedIn() && isActiveProfile() && isAdminProfile(); }
  function lockRequestKeys() { return ['claimedEmail', 'client', 'localLockedUntil', 'createdAt', 'status', 'reviewedAt', 'reviewedBy']; }
  function validLockRequestShape(data) {
    return exactKeys(data, lockRequestKeys()) && data.claimedEmail is string &&
        data.claimedEmail.size() >= 3 && data.claimedEmail.size() <= 320 && data.claimedEmail == data.claimedEmail.lower() &&
        data.claimedEmail.matches('^[^\\s@]+@[^\\s@]+[.][^\\s@]+$') && data.client in ['mobile', 'dashboard'] &&
        data.localLockedUntil is timestamp && data.createdAt is timestamp;
  }
  function validPendingLockRequest(data) {
    return validLockRequestShape(data) && data.createdAt == request.time && data.status == 'pending' && data.reviewedAt == null && data.reviewedBy == null;
  }
  function validLockReceiptShape(data) {
    return exactKeys(data, ['status', 'createdAt', 'reviewedAt']);
  }
  function lockAuditKeys() {
    return ['action', 'entityType', 'entityId', 'summary', 'actorUid', 'actorEmail', 'actorName', 'actorRole', 'metadata', 'createdAt'];
  }
  function validLockAuditShape(data, id) {
    return exactKeys(data, lockAuditKeys()) && data.entityType == 'account_lock_requests' && data.entityId == id &&
        data.createdAt == request.time;
  }
  function validLockReportAudit(data, id, report) {
    return validLockAuditShape(data, id) && data.action == 'local_lock_reported' && data.summary == 'Unverified local lock reported.' &&
        data.actorUid == '' && data.actorEmail == '' && data.actorName == '' && data.actorRole == 'unauthenticated' &&
        data.metadata == {'client': report.client, 'unverified': true};
  }
  function validLockWindowAfter(id) {
    let previous = exists(lockWindowPath()) ? get(lockWindowPath()).data.get('count', 0) : 0;
    let next = existsAfter(lockWindowPath()) ? getAfter(lockWindowPath()).data : {};
    return exactKeys(next, ['count', 'requestId']) && next.requestId == id && next.count is int &&
        next.count == previous + 1 && next.count <= 30;
  }
  function validLockLimitAfter(id, report) {
    let path = lockLimitPath(report.claimedEmail);
    let previousExists = exists(path);
    let previous = previousExists ? get(path).data : {};
    let previousReport = previousExists ? get(lockRequestPath(previous.requestId)).data : {};
    let next = existsAfter(path) ? getAfter(path).data : {};
    return (!previousExists || (previous.createdAt is timestamp && (previousReport.status == 'unlocked' || request.time >= previous.createdAt +
        duration.value(previousReport.client == 'dashboard' ? 15 : 30, 'm')))) &&
        exactKeys(next, ['claimedEmail', 'requestId', 'createdAt']) && next.claimedEmail == report.claimedEmail && next.requestId == id &&
        next.createdAt == request.time;
  }
  function validAtomicLockReport(id) {
    let report = getAfter(lockRequestPath(id)).data;
    let receipt = getAfter(lockReceiptPath(id)).data;
    let audit = getAfter(lockReportAuditPath(id)).data;
    return request.auth == null && validLockId(id) && !exists(lockRequestPath(id)) && !exists(lockReceiptPath(id)) &&
        !exists(lockReportAuditPath(id)) && validPendingLockRequest(report) && validLockReceiptShape(receipt) && receipt.status == 'pending' &&
        receipt.createdAt == request.time && receipt.reviewedAt == null && validLockReportAudit(audit, id, report) && (validLockWindowAfter(id) || validLockLimitAfter(id, report));
  }
  function validLockUnlockAudit(data, id, actorRole) {
    return validLockAuditShape(data, id) && data.action == 'local_lock_unlocked' && data.summary == 'Admin released a reported local retry delay.' &&
        data.actorUid == request.auth.uid && data.actorRole == actorRole && data.actorEmail is string && data.actorEmail.size() <= 320 &&
        data.actorEmail.lower() == request.auth.token.get('email', '').lower() &&
        data.actorName is string && data.actorName.size() <= 200 && data.metadata == {'unverified': true};
  }
  function validAtomicLockUnlock(id) {
    let previous = get(lockRequestPath(id)).data;
    let next = getAfter(lockRequestPath(id)).data;
    let oldReceipt = get(lockReceiptPath(id)).data;
    let receipt = getAfter(lockReceiptPath(id)).data;
    let audit = getAfter(lockUnlockAuditPath(id)).data;
    let actor = caller();
    return signedIn() && actor._active == true && isAdminFor(actor) && validLockId(id) && validLockRequestShape(next) && previous.status == 'pending' &&
        previous.reviewedAt == null && previous.reviewedBy == null && next.diff(previous).affectedKeys().hasOnly(['status', 'reviewedAt', 'reviewedBy']) &&
        next.status == 'unlocked' && next.reviewedAt == request.time && next.reviewedBy == request.auth.uid &&
        validLockReceiptShape(receipt) && oldReceipt.status == 'pending' && oldReceipt.createdAt == previous.createdAt && oldReceipt.reviewedAt == null &&
        receipt.diff(oldReceipt).affectedKeys().hasOnly(['status', 'reviewedAt']) && receipt.status == 'unlocked' && receipt.reviewedAt == request.time &&
        !exists(lockUnlockAuditPath(id)) && validLockUnlockAudit(audit, id, actor.role);
  }
  match /account_lock_requests/{id} {
    allow get, list: if activeLockAdmin();
    allow create: if validAtomicLockReport(id);
    allow update: if validAtomicLockUnlock(id);
    allow delete: if false;
  }
  match /account_lock_receipts/{id} {
    allow get: if validLockId(id);
    allow list: if false;
    allow create: if validAtomicLockReport(id);
    allow update: if validAtomicLockUnlock(id);
    allow delete: if false;
  }
  match /account_lock_limits/{emailKey} {
    allow read, delete: if false;
    allow create, update: if request.auth == null && request.resource.data.claimedEmail is string &&
        emailKey == identityPathPart(request.resource.data.claimedEmail) && getAfter(lockRequestPath(request.resource.data.requestId)).data.claimedEmail ==
        request.resource.data.claimedEmail && validAtomicLockReport(request.resource.data.requestId) &&
        validLockLimitAfter(request.resource.data.requestId, getAfter(lockRequestPath(request.resource.data.requestId)).data);
  }
  match /account_lock_windows/{windowId} {
    allow read, delete: if false;
    allow create, update: if request.auth == null && windowId == lockWindowId() && request.resource.data.requestId is string &&
        validAtomicLockReport(request.resource.data.requestId) && validLockWindowAfter(request.resource.data.requestId);
  }
  match /system_audit_logs/{auditId} {
    function validAuditShape(data) {
      let metadata = data.get('metadata', {});
      return data.keys().hasOnly([ 'action', 'entityType', 'entityId', 'summary', 'actorUid', 'actorEmail', 'actorName', 'actorRole', 'metadata',
          'createdAt' ]) && boundedText(data, 'action', 200) && boundedText(data, 'entityType', 200) && boundedText(data, 'entityId', 400) &&
          boundedText(data, 'summary', data.get('action', '') == 'permission_matrix_updated' ? 50000 : 2000) && boundedText(data, 'actorEmail', 320) && boundedText(data, 'actorName', 200) &&
          boundedText(data, 'actorRole', 50) && metadata is map && metadata.keys().size() <= 50 && metadata.keys().join(',').size() <= 2000;
    }
    function validDashboardAudit(data) {
      let actor = caller();
      let email = request.auth.token.get('email', '').lower();
      return isDashboardRoleFor(actor) && validAuditShape(data) && data.actorUid == request.auth.uid && data.createdAt == request.time &&
          data.get('actorRole', '') in ['', actor.get('role', '')] && data.get('actorEmail', '').lower() in ['', email];
    }
    allow read: if isAdminProfile();
    allow create: if ( auditId == 'lock_request_' + request.resource.data.get('entityId', '') &&
        validAtomicLockReport(request.resource.data.get('entityId', '')) ) || ( auditId == 'lock_unlock_' + request.resource.data.get('entityId', '') &&
        validAtomicLockUnlock(request.resource.data.get('entityId', '')) ) || ( !auditId.matches('^lock_(request|unlock)_.*$') &&
        !(request.resource.data.get('action', '') in ['local_lock_reported', 'local_lock_unlocked']) &&
        request.resource.data.get('entityType', '') != 'account_lock_requests' && signedIn() && validDashboardAudit(request.resource.data) );
    allow update, delete: if false;
  }
}

match /documents {
  function scenarioRunPath(runId) { return /databases/$(database)/documents/scenario_runs/$(runId); }
  function scenarioAccessId(uid, runId) { return identityPathPart(uid) + '_' + identityPathPart(runId); }
  function scenarioAccessPath(uid, runId) { return /databases/$(database)/documents/scenario_run_access/$(scenarioAccessId(uid, runId)); }
  function scenarioAdminSeedActor(actor) { return isCompanyMemberFor(actor) && isAdminFor(actor); }
  function scenarioRunHasState(runId, state) {
    let path = scenarioRunPath(runId);
    let present = exists(path);
    let run = present ? get(path).data : {};
    return present && run.get('runId', '') == runId && run.get('state', '') == state;
  }
  function scenarioIndexMatchesActor(index, runId, actor) {
    let role = actor.get('role', '');
    return index.get('uid', '') == request.auth.uid && index.get('runId', '') == runId && index.get('role', '') == role && ( role in ['admin', 'developer'] || (
        role == 'salesman' && actor.get('salesmanCode', '') != '' && actor.get('branchId', '') != '' && index.get('salesmanUid', '') == request.auth.uid &&
        index.get('salesmanCode', '') == actor.get('salesmanCode', '') && index.get('branchId', '') == actor.get('branchId', '') ) || ( role == 'supervisor' &&
        actor.get('branchId', '') != '' && index.get('branchId', '') == actor.get('branchId', '') && index.get('assignedSalesmanCodes', null) is list &&
        index.assignedSalesmanCodes == actor.get('assignedSalesmanCodes', []) ) || ( role == 'branch_manager' && actor.get('branchId', '') != '' &&
        index.get('branchId', '') == actor.get('branchId', '') ) );
  }
  function scenarioHasReadyRunAccess(runId, actor) {
    let indexPath = scenarioAccessPath(request.auth.uid, runId);
    let indexExists = exists(indexPath);
    let index = indexExists ? get(indexPath).data : {};
    return signedIn() && isCompanyMemberFor(actor) && scenarioRunHasState(runId, 'ready') && indexExists && scenarioIndexMatchesActor(index, runId, actor);
  }
  match /scenario_runs/{runId} {
    function scenarioCanReadRun(runId, run) {
      let actor = caller();
      return signedIn() && isCompanyMemberFor(actor) && run.get('runId', '') == runId && ( ( run.get('state', '') == 'preparing' &&
          scenarioAdminSeedActor(actor) && run.get('createdByUid', '') == request.auth.uid ) || ( run.get('state', '') == 'ready' &&
          scenarioHasReadyRunAccess(runId, actor) ) );
    }
    function validScenarioRunCreate(runId, data) {
      let day = '^[0-9]{4}-[0-9]{2}-[0-9]{2}$';
      return data.keys().hasOnly([ 'runId', 'targetProjectId', 'generatorVersion', 'seed', 'scenarioAsOfDate', 'timeZone', 'rangeStart', 'rangeEnd',
          'sourceSnapshotHash', 'counts', 'createdByUid', 'createdAt', 'readyAt', 'state' ]) && data.keys().size() == 14 &&
          runId.matches('^[A-Za-z0-9_-]{1,64}$') && data.runId == runId && data.targetProjectId is string && data.targetProjectId.size() > 0 &&
          data.generatorVersion is string && data.generatorVersion.size() > 0 && data.seed is int && data.get('scenarioAsOfDate', null) is string &&
          data.scenarioAsOfDate.matches(day) && data.timeZone == 'Asia/Kuala_Lumpur' && data.get('rangeStart', null) is string &&
          data.rangeStart.matches(day) && data.get('rangeEnd', null) is string &&
