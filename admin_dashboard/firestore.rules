rules_version = '2';
service cloud.firestore {
match /databases/{database} {
function signedIn() { return request.auth != null; }
function accessPath() { return /databases/$(database)/documents/user_access/$(request.auth.uid); }
function uidProfilePath() { return /databases/$(database)/documents/users/$(request.auth.uid); }
function hasAccessProfile() { return signedIn() && exists(accessPath()); }
function hasUidProfile() { return signedIn() && exists(uidProfilePath()); }
function text(data, camel, snake) { return data.get(camel, null) is string ? data[camel] : data.get(snake, null) is string ? data[snake] : ''; }
function boundedText(data, key, maxLength) { return data.get(key, '') is string && data.get(key, '').size() <= maxLength; }
function identityPathPart(value) { return value.replace('%', '%25').replace('/', '%2F'); }
function canonicalStopDocId(planId, stopId) {
  return (planId + request.auth.uid + stopId).matches('^[^%/]*$') ? planId + '_' + request.auth.uid + '_' + stopId
      : identityPathPart(planId) + '_' + identityPathPart(request.auth.uid) + '_' + identityPathPart(stopId);
}
function canonicalRole(value) {
  let role = value.lower().replace(' ', '_');
  return role == 'administrator' ? 'admin' : role == 'sales_representative' ? 'salesman' : role;
}
function hasActiveStatus(data) {
  let activeFlag = data.get( 'isActive', data.get('is_active', data.get('active', data.get('enabled', true))) );
  let status = data.get( 'status', data.get('accountStatus', data.get('account_status', 'active')) );
  return (activeFlag == true || activeFlag == 1 || (activeFlag is string && activeFlag.lower() in ['true', '1', 'yes']) ||
      (activeFlag == null && data.get('active', false) == true)) && status in ['active', 'Active'];
}
function accessIdentityMatches(uid, data) { return data.get('uid', uid) == uid && data.get('user_uid', uid) == uid; }
function caller() { return hasAccessProfile() ? callerAccessIdentity(get(accessPath()).data) : legacyUidIdentity(); }
function callerAccessIdentity(accessData) {
  let version = accessData.get('accessVersion', null);
  return version == 2 ? strictAccessIdentity(request.auth.uid, accessData) : version == null ? (!('disabledReasons' in accessData) || lifecycleAllows(accessData.disabledReasons) ? legacyAccessIdentity(accessData) : {'_active': false}) : {'_active': false};
}
function accountAuthorityKeys() {
  return [ 'role', 'user_group', 'status', 'accountStatus', 'account_status', 'isActive', 'is_active', 'active', 'enabled', 'seatClass', 'seatHeld',
      'invitationState', 'disabledReasons', 'deletionRequestedAt', 'deletionPurgeAfter' ];
}
function employeeCodeKeys() { return [ 'employeeCode', 'employee_code', 'staffId', 'staff_id', 'salesmanCode', 'salesman_code' ]; }
function lifecycleAllows(reasons) {
  return reasons is list && (reasons.size() == 0 || (request.method in ['get', 'list'] && reasons.hasOnly(['lifecycle_readonly'])));
}
function lifecycleWritable() { return signedIn() && (hasAccessProfile() ? lifecycleAllows(get(accessPath()).data.get('disabledReasons', [])) : hasUidProfile() && lifecycleAllows(get(uidProfilePath()).data.get('disabledReasons', []))); }
function strictAccessIdentity(uid, access) {
  let codes = access.get('assignedSalesmanCodes', []);
  return access.get('uid', '') == uid && access.get('status', '') == 'active' && access.get('role', '') in [
      'admin', 'developer', 'branch_manager', 'supervisor', 'salesman' ] && access.get('branchId', '') is string && access.get('employeeCode', '') is string &&
      lifecycleAllows(access.get('disabledReasons', [])) ? {
        '_active': true, 'role': access.role, 'branchId': access.get('branchId', ''), 'salesmanCode': access.get('employeeCode', ''),
        'assignedSalesmanCodes': codes is list ? codes : [],
  }
      : {'_active': false};
}
function legacyIdentity(record) {
  let code = record.get('employeeCode', null) is string ? record.employeeCode : record.get('staffId', null) is string ? record.staffId : '';
  let role = record.get('role', null) is string ? record.role : record.get('user_group', null) is string ? record.user_group : '';
  let branchId = record.get('branchId', null) is string ? record.branchId : record.get('branch_id', null) is string ? record.branch_id : '';
  return { '_active': true, 'role': canonicalRole(role), 'branchId': branchId,
        'salesmanCode': code != '' ? code : text(record, 'salesmanCode', 'salesman_code'), 'assignedSalesmanCodes':
        record.get('assignedSalesmanCodes', null) is list ? record.assignedSalesmanCodes : [], };
}
function legacyUidIdentity() {
  let uidExists = hasUidProfile();
  let uidData = uidExists ? get(uidProfilePath()).data : {};
  return uidExists && hasActiveStatus(uidData) && lifecycleAllows(uidData.get('disabledReasons', [])) ? legacyIdentity(uidData) : {'_active': false};
}
function legacyAccessIdentity(accessData) {
  let uid = request.auth.uid;
  let accessIdentityValid = accessData.get('uid', uid) == uid && accessData.get('user_uid', uid) == uid;
  let hasLink = accessData.keys().hasAny(['userDocId', 'user_doc_id']);
  let linkedUserDocId = accessData.get('userDocId', null) is string ? accessData.userDocId : accessData.get('user_doc_id', null) is string
      ? accessData.user_doc_id : '';
  let linked = accessIdentityValid && hasLink && linkedUserDocId != '' && exists( /databases/$(database)/documents/users/$( linkedUserDocId ) );
  let actor = linked ? get( /databases/$(database)/documents/users/$( linkedUserDocId ) ).data : accessData;
  return accessIdentityValid && hasActiveStatus(accessData) && (!hasLink || (linked && hasActiveStatus(actor) && (text(actor, 'uid', 'userUid') == uid ||
      !actor.keys().hasAny(['uid', 'userUid'])))) ? legacyIdentity(actor) : {'_active': false};
}
function isActiveProfile() { return caller()._active == true; }
function companyOnlyReasons(reasons) { return reasons is list && reasons.hasOnly(['billing_lapse', 'trial_expired', 'cancelled', 'lifecycle_readonly']); }
function accountNotSuspended() {
  let accessData = hasAccessProfile() ? get(accessPath()).data : {};
  return hasAccessProfile() ? ( accessData.get('accessVersion', null) == 2 ? accessData.get('status', '') == 'active'
      : legacyAccessIdentity(accessData)._active == true ) && companyOnlyReasons(accessData.get('disabledReasons', [])) :
      hasUidProfile() && hasActiveStatus(get(uidProfilePath()).data) && companyOnlyReasons(get(uidProfilePath()).data.get('disabledReasons', []));
}
function isCompanyMemberFor(actor) {
  return actor._active == true && actor.role in ['admin', 'developer', 'branch_manager', 'supervisor', 'salesman'];
}
function isCompanyMember() { return signedIn() && isCompanyMemberFor(caller()); }
function isAdminProfile() { return isAdminFor(caller()); }
function isAdminFor(actor) { return actor.get('role', '') in ['admin', 'developer']; }
function isDashboardRole() { return isDashboardRoleFor(caller()); }
function isDashboardRoleFor(actor) { return actor.get('role', '') in [ 'admin', 'developer', 'supervisor', 'branch_manager' ]; }
function isSalesmanProfile() { return isSalesmanFor(caller()); }
function isSalesmanFor(actor) { return actor.get('role', '') == 'salesman'; }
function codeInTeam(code, team) { return code != '' && code in team; }
function routeSalesmanUid(route) { return text(route, 'salesmanUid', 'salesman_uid'); }
function routeSalesmanCode(route) { return text(route, 'salesmanCode', 'salesman_code'); }
function routeBranchId(route) { return text(route, 'branchId', 'branch_id'); }
function nonEmptyText(value, maxLength) { return value is string && value.size() > 0 && value.size() <= maxLength; }
function changedKeys() { return request.resource.data.diff(resource.data).affectedKeys(); }
function exactKeys(data, keys) { return data.keys().hasAll(keys) && data.keys().hasOnly(keys); }
function managesScope(actor, code, branch) {
  let role = actor.get('role', '');
  return actor._active == true && ( role in ['admin', 'developer'] || ( role == 'supervisor' && codeInTeam(code,
      actor.assignedSalesmanCodes) ) || ( role == 'branch_manager' && actor.branchId != '' && branch == actor.branchId ) );
}
function changedExactly(keys) {
  let changed = request.resource.data.diff(resource.data).affectedKeys();
  return changed.hasAll(keys) && changed.hasOnly(keys);
}

match /documents {
  function managedIdentityKeys() {
    return accountAuthorityKeys().concat([ 'branchId', 'branch_id', 'supervisorId', 'supervisor_id', 'assignedSalesmanCodes', 'employeeCode', 'staffId',
        'salesmanCode', 'salesman_code' ]);
  }
  function isAccountDeletionAdmin() {
    let actor = caller();
    return actor._active == true && actor.role == 'admin';
  }
  match /privacy_deletion_requests/{uid} {
    function recentSignIn() { return request.auth.token.get('auth_time', 0) >= request.time.toMillis() / 1000 - 3600; }
    function canRequestOwnDeletion(uid) { return signedIn() && request.auth.uid == uid && recentSignIn() && accountNotSuspended(); }
    function validDeletionRequest(data) {
      return data.keys().hasOnly([ 'requestType', 'status', 'createdAt' ]) && data.keys().size() == 3 && data.requestType == 'account_deletion' &&
          data.status == 'submitted' && data.createdAt == request.time;
    }
    allow get: if signedIn() && (request.auth.uid == uid || isAccountDeletionAdmin());
    allow list: if isAccountDeletionAdmin();
    allow create: if canRequestOwnDeletion(uid) && validDeletionRequest(request.resource.data);
    allow update: if ( canRequestOwnDeletion(uid) && resource.data.status == 'rejected' && changedExactly(['status', 'createdAt']) &&
        request.resource.data.requestType == 'account_deletion' && request.resource.data.status == 'submitted' &&
        request.resource.data.createdAt == request.time ) || ( isAccountDeletionAdmin() && changedExactly(['status', 'updatedAt']) &&
        request.resource.data.updatedAt == request.time && ( ( resource.data.status in ['submitted', 'reviewing'] &&
        request.resource.data.status in [ 'reviewing', 'completed', 'rejected' ] ) || ( resource.data.status == 'completed' &&
        !('purgedAt' in resource.data) && request.resource.data.status == 'rejected' ) ) );
    allow delete: if false;
  }
  match /users/{userId} {
    function isCanonicalUserDocument(userId) {
      let accessExists = signedIn() && exists(accessPath());
      let accessData = accessExists ? get(accessPath()).data : {};
      let declaresUserDocId = accessData.keys().hasAny(['userDocId', 'user_doc_id']);
      let linkedUserDocId = text(accessData, 'userDocId', 'user_doc_id');
      return !declaresUserDocId || (linkedUserDocId != '' && userId == linkedUserDocId);
    }
    function isCanonicalUserWrite(userId, data) {
      let profileUid = text(data, 'uid', 'userUid');
      let profileAccessPath = /databases/$(database)/documents/user_access/$(profileUid);
      let profileAccessExists = profileUid != '' && exists(profileAccessPath);
      let profileAccess = profileAccessExists ? get(profileAccessPath).data : {};
      let indexedDocumentId = text(profileAccess, 'userDocId', 'user_doc_id');
      let indexedProfileMatches = !profileAccessExists || !profileAccess.keys().hasAny(['userDocId', 'user_doc_id']) ||
          (indexedDocumentId != '' && indexedDocumentId == userId);
      let callerIdentity = userId == request.auth.uid || profileUid == request.auth.uid;
      return indexedProfileMatches && (!callerIdentity || isCanonicalUserDocument(userId));
    }
    function isSelfUserProfile(userId, profile) {
      let actorAccessExists = exists(accessPath());
      let actorAccess = actorAccessExists ? get(accessPath()).data : {};
      let declaresProfile = actorAccess.keys().hasAny([ 'userDocId', 'user_doc_id' ]);
      let actorProfileId = text(actorAccess, 'userDocId', 'user_doc_id');
      return request.auth.uid == userId || request.auth.uid == text(profile, 'uid', 'userUid') || (declaresProfile && actorProfileId == userId);
    }
    function selfProfileLockedKeys() { return managedIdentityKeys().concat([ 'uid', 'userUid', 'userId', 'user_id', 'employee_code', 'staff_id' ]); }
    function isSelfProfilePrivilegeEscalation(userId, profile) {
      return isSelfUserProfile(userId, profile) && request.resource.data.diff(profile).affectedKeys().hasAny(selfProfileLockedKeys());
    }
    function validUserProvisioningUpdate(userId, previous) {
      let changed = request.resource.data.diff(previous).affectedKeys();
      let markers = [ 'provisioningState', 'provisioningByUid' ];
      let changesMarker = changed.hasAny(markers);
      let targetUid = text(previous, 'uid', 'userUid');
      let targetAccess = /databases/$(database)/documents/user_access/$(targetUid);
      return !changesMarker || ( previous.get('provisioningState', '') == 'pending' && previous.get('provisioningByUid', '') == request.auth.uid &&
          changed.hasAll(markers) && changed.hasOnly(markers) && !request.resource.data.keys().hasAny(markers) && targetUid != '' &&
          existsAfter(targetAccess) && getAfter(targetAccess).data.get('uid', '') == targetUid && getAfter(targetAccess).data.get('userDocId', '') == userId );
    }
    function userServerOnlyChange() {
      let changed = changedKeys();
      return changed.hasAny(accountAuthorityKeys()) || changed.hasAny(employeeCodeKeys());
    }
    function userEmployeeCode(data) {
      let code = text(data, 'employeeCode', 'employee_code');
      return code != '' ? code : text(data, 'staffId', 'staff_id');
    }
    function canReadUserProfile(userId, data) {
      return ( signedIn() && isCanonicalUserDocument(userId) && ( userId == request.auth.uid || text(data, 'uid', 'userUid') == request.auth.uid ) ) ||
          canManageUserProfile(data, caller());
    }
    function canManageUserProfile(data, actor) {
      let role = actor.get('role', '');
      return actor._active == true && ( role in ['admin', 'developer'] || ( role == 'supervisor' &&
          codeInTeam(userEmployeeCode(data), actor.assignedSalesmanCodes) ) || ( role == 'branch_manager' && actor.branchId != '' &&
          text(data, 'branchId', 'branch_id') == actor.branchId && isBranchStaffRoleText(text(data, 'role', 'user_group')) ) );
    }
    function isBranchStaffRoleText(value) { return canonicalRole(value) in ['salesman', 'supervisor', 'branch_manager']; }
    allow read: if canReadUserProfile(userId, resource.data);
    allow create: if false;
    allow update: if ( isAdminProfile() && !userServerOnlyChange() && !isSelfProfilePrivilegeEscalation(userId, resource.data) &&
        validUserProvisioningUpdate(userId, resource.data) &&
        isCanonicalUserWrite(userId, resource.data) && isCanonicalUserWrite(userId, request.resource.data) ) || ( signedIn() &&
        isActiveProfile() && (userId == request.auth.uid || resource.data.uid == request.auth.uid) && isCanonicalUserDocument(userId) &&
        !changedKeys().hasAny(selfProfileLockedKeys().concat([ 'provisioningState', 'provisioningByUid' ])) );
    allow delete: if false;
  }
  match /user_access/{uid} {
    function sameRole(left, right) { return canonicalRole(left) == canonicalRole(right); }
    function validAccessIndex(uid, data) {
      let userDocId = text(data, 'userDocId', 'user_doc_id');
      let linkedProfile = /databases/$(database)/documents/users/$(userDocId);
      return accessIdentityMatches(uid, data) && text(data, 'uid', 'user_uid') == uid && data.keys().hasAny(['userDocId', 'user_doc_id']) && userDocId != '' &&
          exists(linkedProfile) && sameRole( text(data, 'role', 'user_group'), text(get(linkedProfile).data, 'role', 'user_group') ) && (
          !get(linkedProfile).data.keys().hasAny(['uid', 'userUid']) || text(get(linkedProfile).data, 'uid', 'userUid') == uid );
    }
    function isSelfPrivilegeEscalation(targetUid) {
      return request.auth.uid == targetUid && changedKeys().hasAny(managedIdentityKeys().concat([ 'accessVersion', 'supervisorUid', 'orgId',
          'userDocId', 'user_doc_id' ]));
    }
    function accessServerOnlyChange() {
      let changed = changedKeys();
      return changed.hasAny(accountAuthorityKeys().concat([ 'accessVersion', 'uid' ])) || changed.hasAny(employeeCodeKeys());
    }
    function validAccessWrite(uid, data, previous) {
      return 'accessVersion' in data ? validV2AccessRecord(uid, data) : !('accessVersion' in previous) &&
          validAccessIndex(uid, data);
    }
    function validSeatClass(role, seatClass) {
      return role == 'salesman' ? seatClass in ['salesman', 'salesperson'] : role == 'supervisor' ? seatClass in ['supervisor', 'free'] :
          role in ['admin', 'branch_manager'] ? seatClass in ['manager', 'free'] : seatClass in ['none', 'free'];
    }
    function validV2AccessRecord(uid, data) {
      let role = data.get('role', '');
      let codes = data.get('assignedSalesmanCodes', []);
      let profileId = data.get('userDocId', '');
      let supervisorUid = data.get('supervisorUid', '');
      return data.keys().hasAll([ 'accessVersion', 'uid', 'role', 'status', 'branchId', 'employeeCode', 'userDocId' ]) && data.accessVersion is int &&
          data.accessVersion == 2 && data.uid == uid && role in ['admin', 'developer', 'branch_manager', 'supervisor', 'salesman'] &&
          data.status in ['active', 'suspended'] && data.branchId is string && (data.branchId != '' || role in ['admin', 'developer']) &&
          data.employeeCode is string && supervisorUid is string && (role == 'salesman' || supervisorUid == '') &&
          codes is list && codes.size() <= (role == 'supervisor' ? 5 : 0) && data.get('orgId', '') is string &&
          validSeatClass(role, data.get('seatClass', role == 'salesman' ? 'salesperson' : 'free')) && profileId is string &&
          profileId != '' && existsAfter(/databases/$(database)/documents/users/$(profileId)) && v2ProfileMirrors(
          getAfter(/databases/$(database)/documents/users/$(profileId)).data, uid, role, data.status );
    }
    function v2ProfileMirrors(profile, uid, role, status) {
      return canonicalRole(text(profile, 'role', 'user_group')) == role && hasActiveStatus(profile) == (status == 'active') &&
          (!profile.keys().hasAny(['uid', 'userUid']) || text(profile, 'uid', 'userUid') == uid);
    }
    allow read: if signedIn() && (request.auth.uid == uid || isAdminProfile());
    allow create: if false;
    allow update: if isAdminProfile() && !accessServerOnlyChange() && !isSelfPrivilegeEscalation(uid) && validAccessWrite(uid, request.resource.data, resource.data);
    allow delete: if false;
  }
}

match /documents {
  function permissionMatrixPath() { return /databases/$(database)/documents/system_access_config/permission_matrix; }
  function matrixBaselineAllows(role, action) { return role == 'admin' || (action == 'view' && role in ['branch_manager', 'supervisor']); }
  function matrixGrantAllows(role, module, action) { return role == 'developer' || storedGrantAllows(role, module, action); }
  function storedGrantAllows(role, module, action) {
    let hasDocument = exists(permissionMatrixPath());
    let roles = hasDocument ? get(permissionMatrixPath()).data.get('roles', {}) : {};
    let hasRow = roles is map && roles.keys().hasAny([role]);
    return hasRow ? roles[role] is list && (module + ':' + action) in roles[role] : matrixBaselineAllows(role, action);
  }
  function moduleAction(module, action) {
    let role = caller().get('role', '');
    return role in ['admin', 'developer'] && matrixGrantAllows(role, module, action);
  }
  function retailerPath(retailerId) { return /databases/$(database)/documents/retailers/$(retailerId); }
  function actorOwnsRetailer(retailer, actor) {
    let team = actor.get('assignedSalesmanCodes', []).removeAll(['']);
    let owner = retailer.get('assignedSalesmanId', '');
    let listed = retailer.get('assignedSalesmanCodes', []);
    return actor.get('role', '') == 'supervisor' ? ((owner is string && owner != '' && owner in team) || (listed is list && listed.removeAll(['']).hasAny(team)))
        : actor.get('branchId', '') != '' && text(retailer, 'branchId', 'branch_id') == actor.get('branchId', '');
  }
  function moduleActionFor(actor, module, action) {
    let role = actor.get('role', '');
    return role in ['admin', 'developer'] && matrixGrantAllows(role, module, action);
  }
  function delegatedWrite(actor, module, action, retailerId) { return moduleActionFor(actor, module, action) || scopedModuleActionFor(actor, module, action, retailerId); }
  function scopedModuleActionFor(actor, module, action, retailerId) {
    let role = actor.get('role', '');
    return actor._active == true && role in ['supervisor', 'branch_manager'] && retailerId is string && retailerId != '' &&
        storedGrantAllows(role, module, 'view') && storedGrantAllows(role, module, action) && actorOwnsRetailer(get(retailerPath(retailerId)).data, actor);
  }
  function companyModuleAction(module, action) {
    let actor = caller();
    let role = actor.get('role', '');
    return role in ['admin', 'developer'] ? matrixGrantAllows(role, module, action)
        : role in ['supervisor', 'branch_manager'] && grantedRowAllows(role, module, action);
  }
  function grantedRowAllows(role, module, action) {
    let roles = exists(permissionMatrixPath()) ? get(permissionMatrixPath()).data.get('roles', {}) : {};
    let row = roles is map ? roles.get(role, []) : [];
    return row is list && (module + ':view') in row && (module + ':' + action) in row;
  }
  function moduleReadAllowed(module) {
    let actor = caller();
    return signedIn() && isCompanyMemberFor(actor) && (!isDashboardRoleFor(actor) || matrixGrantAllows(actor.role, module, 'view'));
  }
  match /products/{docId} {
    function validProductText(data, changed, key, maxLength) {
      let value = data.get(key, '');
      return !(key in changed) || (value is string && value.size() <= maxLength);
    }
    function validProductNumber(data, changed, key) { return !(key in changed) || validProductNumberValue(data, key); }
    function validProductInt(data, changed, key) { return !(key in changed) || validProductIntValue(data, key); }
    function productWritableKeys() {
      return [ 'productId', 'departmentId', 'categoryId', 'departmentName', 'departmentManagerName', 'mainCategoryName', 'categoryName',
          'subCategoryName', 'itemName', 'productName', 'productFlavor', 'flavor', 'itemCode', 'productCode', 'sku', 'barcode', 'itemBarcode',
          'packingSize', 'unitPrice', 'price', 'priceGuide', 'uom', 'uomLabel', 'unitOfMeasure', 'sortOrder', 'brandName', 'isVisible', 'status',
          'importSource', 'mobileDisplayMode', 'maxOrderQty', 'createdAt', 'updatedAt', 'priceUpdatedAt' ];
    }
    function validMaxOrderQty(data) {
      return !('maxOrderQty' in data) || (data.maxOrderQty is int && data.maxOrderQty >= 1 && data.maxOrderQty <= 999);
    }
    function validProductFields(data, changed) {
      return (data.get('productId', '').matches('^[^𐀀-􏿿]{0,100}$') || validProductText(data, changed, 'productId', 100)) &&
          (data.get('departmentId', '').matches('^[^𐀀-􏿿]{0,100}$') || validProductText(data, changed, 'departmentId', 100)) &&
          (data.get('categoryId', '').matches('^[^𐀀-􏿿]{0,200}$') || validProductText(data, changed, 'categoryId', 200)) &&
          (data.get('departmentName', '').matches('^[^𐀀-􏿿]{0,100}$') || validProductText(data, changed, 'departmentName', 100)) &&
          (data.get('departmentManagerName', '').matches('^[^𐀀-􏿿]{0,100}$') || validProductText(data, changed, 'departmentManagerName', 100)) &&
          (data.get('mainCategoryName', '').matches('^[^𐀀-􏿿]{0,100}$') || validProductText(data, changed, 'mainCategoryName', 100)) &&
          (data.get('categoryName', '').matches('^[^𐀀-􏿿]{0,100}$') || validProductText(data, changed, 'categoryName', 100)) &&
          (data.get('subCategoryName', '').matches('^[^𐀀-􏿿]{0,100}$') || validProductText(data, changed, 'subCategoryName', 100)) &&
          (data.get('itemName', '').matches('^[^𐀀-􏿿]{0,200}$') || validProductText(data, changed, 'itemName', 200)) &&
          (data.get('productName', '').matches('^[^𐀀-􏿿]{0,200}$') || validProductText(data, changed, 'productName', 200)) &&
          (data.get('productFlavor', '').matches('^[^𐀀-􏿿]{0,200}$') || validProductText(data, changed, 'productFlavor', 200)) &&
          (data.get('flavor', '').matches('^[^𐀀-􏿿]{0,200}$') || validProductText(data, changed, 'flavor', 200)) &&
          (data.get('itemCode', '').matches('^[^𐀀-􏿿]{0,100}$') || validProductText(data, changed, 'itemCode', 100)) &&
          (data.get('productCode', '').matches('^[^𐀀-􏿿]{0,100}$') || validProductText(data, changed, 'productCode', 100)) &&
          (data.get('sku', '').matches('^[^𐀀-􏿿]{0,100}$') || validProductText(data, changed, 'sku', 100)) &&
          (data.get('barcode', '').matches('^[^𐀀-􏿿]{0,100}$') || validProductText(data, changed, 'barcode', 100)) &&
          (data.get('itemBarcode', '').matches('^[^𐀀-􏿿]{0,100}$') || validProductText(data, changed, 'itemBarcode', 100)) &&
          (data.get('packingSize', '').matches('^[^𐀀-􏿿]{0,100}$') || validProductText(data, changed, 'packingSize', 100)) &&
          (data.get('uom', '').matches('^[^𐀀-􏿿]{0,32}$') || validProductText(data, changed, 'uom', 32)) &&
          (data.get('uomLabel', '').matches('^[^𐀀-􏿿]{0,32}$') || validProductText(data, changed, 'uomLabel', 32)) &&
          (data.get('unitOfMeasure', '').matches('^[^𐀀-􏿿]{0,32}$') || validProductText(data, changed, 'unitOfMeasure', 32)) &&
          (data.get('brandName', '').matches('^[^𐀀-􏿿]{0,100}$') || validProductText(data, changed, 'brandName', 100)) &&
          (data.get('mobileDisplayMode', '').matches('^[^𐀀-􏿿]{0,32}$') || validProductText(data, changed, 'mobileDisplayMode', 32));
    }
    function validProductWrite(data, changed) {
      return changed.hasOnly(productWritableKeys()) && !changed.hasAny(['isVisible', 'status', 'visible', 'productStatus']) && validProductFields(data, changed) &&
          validProductInt(data, changed, 'sortOrder') && validProductNumber(data, changed, 'unitPrice') &&
          validProductNumber(data, changed, 'price') && validProductNumber(data, changed, 'priceGuide') &&
          (data.get('createdAt', null) is timestamp || !('createdAt' in changed)) &&
          (data.get('updatedAt', null) is timestamp || !('updatedAt' in changed)) &&
          (validMaxOrderQty(data) || !('maxOrderQty' in changed)) &&
          (!('importSource' in data) || (data.importSource is string && data.importSource.size() <= 128)) &&
          ('priceUpdatedAt' in changed ? data.get('priceUpdatedAt', null) == request.time : !changed.hasAny(['unitPrice', 'price', 'priceGuide']));
    }
    function validProductCreate(data) {
      return data.get('isVisible', null) == false && data.get('status', null) == 'hidden' && data.keys().hasOnly(productWritableKeys()) &&
          validProductFields(data, data.keys()) && validProductIntValue(data, 'sortOrder') && validProductNumberValue(data, 'unitPrice') &&
          validProductNumberValue(data, 'price') && validProductNumberValue(data, 'priceGuide') &&
          (data.get('importSource', '').matches('^[^𐀀-􏿿]{0,128}$') || validProductText(data, data.keys(), 'importSource', 128)) &&
          data.get('createdAt', request.time) is timestamp && data.get('updatedAt', request.time) is timestamp &&
          data.get('priceUpdatedAt', request.time) == request.time && validMaxOrderQty(data);
    }
    function validProductNumberValue(data, key) {
      let value = data.get(key, 0);
      return value is number && value >= 0 && value <= 1000000;
    }
    function validProductIntValue(data, key) {
      let value = data.get(key, 0);
      return value is int && value >= 0 && value <= 1000000;
    }
    function validProductDocumentId(docId) { return docId is string && docId.size() > 0 && docId.size() <= 100; }
    allow read: if moduleReadAllowed('products');
    allow create: if companyModuleAction('products', 'create') ? validProductDocumentId(docId) && validProductCreate(request.resource.data) : false;
    allow update: if companyModuleAction('products', 'edit') ? validProductWrite( request.resource.data, request.resource.data.diff(resource.data).affectedKeys() )
        : false;
    allow delete: if false;
  }
  match /departments/{docId} {
    allow read: if moduleReadAllowed('departments');
    allow create: if companyModuleAction('departments', 'create');
    allow update: if companyModuleAction('departments', 'edit');
    allow delete: if companyModuleAction('departments', 'delete');
  }
  match /categories/{docId} {
    allow read: if moduleReadAllowed('categories');
    allow create: if companyModuleAction('categories', 'create');
    allow update: if companyModuleAction('categories', 'edit');
    allow delete: if companyModuleAction('categories', 'delete');
  }
  match /score_sheets/{docId} {
