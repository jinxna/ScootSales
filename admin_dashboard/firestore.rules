}

match /documents {
  function canManageOrderFor(order, actor) {
    return actor._active == true && ( actor.role in ['admin', 'developer'] || ( actor.role == 'supervisor' &&
        codeInTeam(scopedSalesmanCode(order), actor.assignedSalesmanCodes) ) );
  }
  function orderAuditKeys() {
    return [ 'action', 'orderDocumentId', 'orderId', 'previousStatus', 'actorUid', 'actorRole', 'retailerId', 'salesmanUid', 'occurredAt' ];
  }
  function orderPath(orderDocumentId) { return /databases/$(database)/documents/orders/$(orderDocumentId); }
  function orderAuditOrderId(orderDocumentId, order) {
    return 'orderId' in order && order.orderId is string && order.orderId != '' ? order.orderId : orderDocumentId;
  }
  function orderAuditPreviousStatus(order) { return 'status' in order && order.status is string ? order.status : ''; }
  function validOrderAudit(auditId, audit, order, actorRole) {
    return exactKeys(audit, orderAuditKeys()) && audit.action == 'delete' && audit.orderDocumentId == auditId && audit.orderId == orderAuditOrderId(auditId, order) && audit.previousStatus == orderAuditPreviousStatus(order) && audit.actorUid == request.auth.uid &&
        audit.actorRole == actorRole && audit.retailerId == text(order, 'retailerId', 'retailer_id') && audit.salesmanUid == text(order, 'salesmanUid', 'salesman_uid') && audit.occurredAt == request.time;
  }
  function routeOpenToSalesman(route) {
    return route.status == 'published' || replacedRouteOpenToStartedRun(route);
  }
  function replacedRouteOpenToStartedRun(route) {
    let planKey = route.get('planId', '');
    let progressPath = /databases/$(database)/documents/route_plan_progress/$(planKey + '_' + request.auth.uid);
    return route.status == 'archived' && planKey != '' && route.get('replacedAt', null) is timestamp &&
        request.time < route.replacedAt + duration.value(24, 'h') && exists(progressPath) && get(progressPath).data.get('status', '') in ['in_progress', 'completed'];
  }
  function isOwnPublishedRoute(route, actor) {
    return actor.get('role', '') == 'salesman' && routeOpenToSalesman(route) && ( routeSalesmanUid(route) == request.auth.uid || (
        actor.get('salesmanCode', '') != '' && routeSalesmanCode(route) == actor.get('salesmanCode', '') ) );
  }
  function canManageRoute(route) { return canManageRouteFor(route, caller()); }
  function canWriteRouteFor(route, actor) {
    let role = actor.get('role', '');
