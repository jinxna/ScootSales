      let validRetirement = !retirementRequested || ( ![existing.get('isDemo', false), existing.get('is_demo', false), existing.get('demo', false)].hasAny([true, 'true']) && changed.hasOnly([ 'status', 'stockListVisible', 'retiredAt', 'retiredByUid', 'retiredByRole', 'updatedAt' ]) &&
          incoming.status == 'retired' && incoming.stockListVisible == false && incoming.retiredAt == request.time && incoming.updatedAt == request.time &&
