# Normalize all text files to LF in the repository
* text=auto eol=lf

# Windows scripts keep CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.apk binary
*.jar binary
*.keystore binary
*.pdf binary
packages/scoot_design/LICENSE -whitespace
packages/scoot_design/assets/fonts/**/OFL.txt -whitespace
