[Unit]
Description=Scoot Sales platform service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=scoot
Group=scoot
WorkingDirectory=/opt/scoot/platform
EnvironmentFile=/etc/scoot/platform.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/scoot/platform/venv/bin/python -m uvicorn platform_service.app:create_app --factory --host 127.0.0.1 --port 8100 --proxy-headers --forwarded-allow-ips 127.0.0.1
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
